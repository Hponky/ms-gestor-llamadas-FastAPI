# ==============================================================================
# HAR-228 ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- APP CONFIG ---
APP_ENV=development           # options: development, production
LOG_LEVEL=INFO

# --- PROVIDERS SELECTOR ---
LLM_PROVIDER=openrouter       # options: openrouter, openai, gemini
TTS_PROVIDER=edge_tts
VECTOR_STORE_PROVIDER=qdrant  # options: qdrant
SESSION_PROVIDER=memory        # options: memory, redis (use memory for local dev without redis)

# --- LLM SETTINGS (OpenRouter) ---
# Get yours at https://openrouter.ai/
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=mistralai/devstral-2512:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- EMBEDDING SETTINGS ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- VECTOR STORE (Qdrant) ---
# LOCAL (Docker): http://localhost:6333
# CLOUD (Managed): https://xxxx-xxxx.qdrant.tech:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=               # Leave empty for local docker unless configured
QDRANT_COLLECTION=kb_har_228

# --- SESSIONS (Redis) ---
# LOCAL (Docker): localhost
# CLOUD (Managed): redis-xxxx.upstash.io
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for local docker
REDIS_TTL=3600                # Session time-to-live in seconds (1h)
